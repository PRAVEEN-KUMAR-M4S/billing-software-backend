# Copy to .env and fill in. Never commit .env.
#
# This file is a TEMPLATE and is tracked by git, so every secret here is a
# placeholder. The real password belongs in .env (git-ignored) and in the host's
# environment variables -- nowhere else, and never in this file.

# --- Database: Neon Postgres -----------------------------------------------
# Neon dashboard -> Connect -> "Pooled connection". Paste that string exactly as
# it is, only replacing REPLACE_WITH_PASSWORD. No +asyncpg, no ssl editing: the
# app rewrites it on load (see _normalise_database_url in app/config.py):
#   postgresql://   -> postgresql+asyncpg://  (the async driver)
#   sslmode=require -> ssl=require            (asyncpg's spelling)
#   channel_binding -> dropped                (libpq-only; asyncpg rejects it)
#   -pooler host    -> both statement caches off (PgBouncer reuses sessions)
DATABASE_URL=postgresql://neondb_owner:REPLACE_WITH_PASSWORD@ep-still-night-bb5rzmim-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# No Postgres needed for a quick local run: comment the line above, uncomment
# this one, and the app uses a throwaway file instead.
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Long random string -- signs the JWTs.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Gemini key for bill extraction: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id lives here, not in code (model names change).
# gemini-3.5-flash is deprecated and now routes to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Tried once each, in order, only when a model is busy (503 UNAVAILABLE --
# high demand). A second key would not help: limits and overload are per
# project/model. Not used for quota (429) -- that waits for the daily reset.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
