# Copy to .env and fill in. Never commit .env.

# Long random string — signs the JWTs.
SECRET_KEY=change-me-to-a-long-random-string

# Gemini key for bill extraction: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id lives here, not in code (model names change).
# gemini-3.5-flash is deprecated and now routes to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Tried once each, in order, only when a model is busy (503 UNAVAILABLE —
# high demand). A second key would not help: limits and overload are per
# project/model. Not used for quota (429) — that waits for the daily reset.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
