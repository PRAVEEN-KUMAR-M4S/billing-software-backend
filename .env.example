# Copy to .env and fill in. Never commit .env.

# Long random string — signs the JWTs.
SECRET_KEY=change-me-to-a-long-random-string

# Gemini key for bill extraction: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id lives here, not in code (model names change).
# gemini-3.5-flash is deprecated and now routes to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
